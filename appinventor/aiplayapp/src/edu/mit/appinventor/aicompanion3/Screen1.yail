 (set-and-coerce-property! 'Screen1 'Title "MIT App Inventor Companion" 'text)
)

(define-event Screen1 Initialize()(set-this-form)
  (call-component-method 'PhoneStatus1 'StyleCompanionMainButton
    (*list-for-runtime* (get-component ConnectButton)) '(component))

  (call-component-method 'PhoneStatus1 'StyleCompanionMainButton
    (*list-for-runtime* (get-component ScanButton)) '(component))

  (call-component-method 'PhoneStatus1 'StyleCompanionMainButton
    (*list-for-runtime* (get-component LibraryButton)) '(component))

  (call-component-method 'PhoneStatus1 'StyleCompanionHomeButton
    (*list-for-runtime* (get-component CodeBox)) '(component))

  (call-component-method 'PhoneStatus1 'StyleCompanionTutorialLink
    (*list-for-runtime* (get-component TutorialLink)) '(component))

    (set-var! g$rendezvousServer ((get-var p$getRendezvousServer) ))(if (call-component-method 'PhoneStatus1 'isDirect (*list-for-runtime*) '()) (begin   (set-and-coerce-property! 'PhonePanel 'Visible #f 'boolean)(set-and-coerce-property! 'EmulatorPanel 'Visible #t 'boolean)((get-var p$startdirectconnect) )) (begin   (set-and-coerce-property! 'PhonePanel 'Visible #t 'boolean)(set-and-coerce-property! 'EmulatorPanel 'Visible #f 'boolean)(set-and-coerce-property! 'ipaddrlabel 'Text (call-component-method 'PhoneStatus1 'GetWifiIpAddress (*list-for-runtime*) '()) 'text)((get-var p$checkWiFi) )))(call-component-method 'PhoneStatus1 'setAssetsLoaded (*list-for-runtime*) '())(set-and-coerce-property! 'versionlabel 'Text (call-component-method 'PhoneStatus1 'GetVersionName (*list-for-runtime*) '()) 'text)(set-and-coerce-property! 'PhoneStatus1 'WebRTC (get-property 'CheckBox1 'Checked) 'boolean))
