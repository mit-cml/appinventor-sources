  (set-and-coerce-property! 'WelcomeSpacer 'HasMargins #f 'boolean)
  (set-and-coerce-property! 'WelcomeSpacer 'Height 32 'number)
  (set-and-coerce-property! 'WelcomeSpacer 'Text "" 'text)
)

;;; WelcomeLabel

(add-component PhonePanel com.google.appinventor.components.runtime.Label WelcomeLabel
  (set-and-coerce-property! 'WelcomeLabel 'FontSize 16 'number)
  (set-and-coerce-property! 'WelcomeLabel 'HasMargins #f 'boolean)
  (set-and-coerce-property! 'WelcomeLabel 'Width -2 'number)
  (set-and-coerce-property! 'WelcomeLabel 'TextAlignment 1 'number)
  (set-and-coerce-property! 'WelcomeLabel 'Text "New to MIT App Inventor?\nTry our beginner tutorials\nby opening" 'text)
)

;;; TutorialLink

(add-component PhonePanel com.google.appinventor.components.runtime.Button TutorialLink
  (set-and-coerce-property! 'TutorialLink 'BackgroundColor #x00FFFFFF 'number)
  (set-and-coerce-property! 'TutorialLink 'TextColor #xFF0A3A8C 'number)
  (set-and-coerce-property! 'TutorialLink 'FontBold #t 'boolean)
  (set-and-coerce-property! 'TutorialLink 'FontSize 16 'number)
  (set-and-coerce-property! 'TutorialLink 'Width -2 'number)
  (set-and-coerce-property! 'TutorialLink 'TextAlignment 1 'number)
  (set-and-coerce-property! 'TutorialLink 'Text "https://appinventor.mit.edu/get-started" 'text)
)

;;; WelcomeFooter

