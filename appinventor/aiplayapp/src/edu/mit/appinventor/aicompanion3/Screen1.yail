  (set-and-coerce-property! 'WelcomeFooter 'FontSize 16 'number)
  (set-and-coerce-property! 'WelcomeFooter 'Width -2 'number)
  (set-and-coerce-property! 'WelcomeFooter 'TextAlignment 1 'number)
  (set-and-coerce-property! 'WelcomeFooter 'HasMargins #f 'boolean)
  (set-and-coerce-property! 'WelcomeFooter 'Text "on your computer" 'text)
)

;;; TutorialBrowser

(add-component MainPanel com.google.appinventor.components.runtime.ActivityStarter TutorialBrowser
  (set-and-coerce-property! 'TutorialBrowser 'Action "android.intent.action.VIEW" 'text)
  (set-and-coerce-property! 'TutorialBrowser 'DataUri "https://appinventor.mit.edu/get-started" 'text)
)

(define-event TutorialLink Click()(set-this-form)
  (call-component-method 'TutorialBrowser 'StartActivity (*list-for-runtime*) '()))

;;; PhoneStatus1

(add-component MainPanel com.google.appinventor.components.runtime.PhoneStatus PhoneStatus1 
)

(define-event PhoneStatus1 OnSettings()(set-this-form)
  (call-component-method 'PhoneStatus1 'StyleCompanionHomeButton
    (*list-for-runtime* (get-component SettingsHome)) '(component))

  (set-and-coerce-property! 'Screen1 'TitleVisible #f 'boolean)
  (set-and-coerce-property! 'Screen1 'Scrollable #f 'boolean)
  (set-and-coerce-property! 'ipaddrlabel 'Text (call-component-method 'PhoneStatus1 'GetWifiIpAddress (*list-for-runtime*) '()) 'text)
  (set-and-coerce-property! 'versionlabel 'Text (call-component-method 'PhoneStatus1 'GetVersionName (*list-for-runtime*) '()) 'text)

    (set-and-coerce-property! 'MainPanel 'Visible #f 'boolean)(set-and-coerce-property! 'SettingsPanel 'Visible #t 'boolean)(set-and-coerce-property! 'rendezvoustextbox 'Text ((get-var p$getRendezvousServer) ) 'text)(set-and-coerce-property! 'aidLabel 'Text (call-component-method 'PhoneStatus1 'InstallationId (*list-for-runtime*) '()) 'text))
;;; Web1

(add-component MainPanel com.google.appinventor.components.runtime.Web Web1 
)

(define-event Web1 GotText($url $responseCode $responseType $responseContent)(set-this-form)
    (if (get-property 'CheckBox1 'Checked) (begin   (call-component-method 'PhoneStatus1 'SetPopup (*list-for-runtime* (lexical-value $responseContent)) '(text))) (begin   (call-component-method 'PhoneStatus1 'startWebRTC (*list-for-runtime* (get-var g$rendezvousServer)  (lexical-value $responseContent)) '(text text)))))
;;; BarcodeScanner1

(add-component MainPanel com.google.appinventor.components.runtime.BarcodeScanner BarcodeScanner1 
(set-and-coerce-property! 'BarcodeScanner1 'UseExternalScanner #f 'boolean)

)

(define-event BarcodeScanner1 AfterScan($result)(set-this-form)
    (set-and-coerce-property! 'CodeBox 'Text (lexical-value $result) 'text)((get-var p$processcode) (lexical-value $result)))
;;; Notifier1

(add-component MainPanel com.google.appinventor.components.runtime.Notifier Notifier1 
)

(define-event Notifier1 AfterChoosing($choice)(set-this-form)
    (if (call-yail-primitive yail-equal? (*list-for-runtime* (lexical-value $choice) "Exit") '(any any) "=") (begin   (call-component-method 'PhoneStatus1 'shutdown (*list-for-runtime*) '()))))
;;; TinyDB1

(add-component Screen1 com.google.appinventor.components.runtime.TinyDB TinyDB1 
)

(init-runtime)