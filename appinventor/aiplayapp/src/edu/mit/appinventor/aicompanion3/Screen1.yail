(set-and-coerce-property! 'LibraryButton 'BackgroundColor #xFF92257B 'number)

(set-and-coerce-property! 'LibraryButton 'FontSize 30 'number)

(set-and-coerce-property! 'LibraryButton 'Height 48 'number)

(set-and-coerce-property! 'LibraryButton 'Shape 1 'number)

(set-and-coerce-property! 'LibraryButton 'Text "My Saved Apps" 'text)

(set-and-coerce-property! 'LibraryButton 'TextColor #xFFFFFFFF 'number)

(set-and-coerce-property! 'LibraryButton 'Width 300 'number)

)

(define-event LibraryButton Click()(set-this-form)
    (call-component-method 'PhoneStatus1 'loadProjects (*list-for-runtime*) '()))
;;; WelcomeSpacer

